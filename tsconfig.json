{
  // Solo per il controllo dei tipi: `npm run tipi`.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker/**/*.ts", "src/**/*.ts"],
  // File solo Node: i loro globali vanno in conflitto con quelli di Cloudflare.
  "exclude": ["src/cli.ts", "src/server.ts", "src/store.ts", "src/core/llm.ts"]
}
