{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pianificatore-dieta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",

  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    // Il Worker deve passare prima degli asset: protegge /studio.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pianificatore",
      "database_id": "bed28556-91b5-4c90-af5a-eadd4066c1b4"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "MODELLO_AI": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
    // CODICE_STUDIO va impostato con `wrangler secret put`, non qui.
  },

  "observability": {
    "enabled": true
  }
}
